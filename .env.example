# Triad Hub 环境变量示例（复制为 .env 并填入本机凭据）
# 铁律：.env 不得提交、不得发聊天、不得被任何脚本读取回显或复制。
# 本文件只允许出现空值或非敏感示例值，绝不含真实凭据、绝不含 Codex 物理 task id。
# 注意：留空的行等价于"未设置"，程序会回落代码内默认值（见 config._env）。
# 不需要覆盖的项请整行注释掉，而不是写成 KEY=（历史上空值曾把 DB_PATH 覆盖成空串）。

# ---------- WB 传输（二选一：HTTP 网关或固定 CLI 会话）----------
# 默认 gateway_http；如选 cli_fixed_session，仍需单独建立已验证的 WB 绑定。
# TRIAD_WB_TRANSPORT=cli_fixed_session
# TRIAD_WB_CLI_ENTRY=C:/path/to/codebuddy-cli-entry
# TRIAD_WB_CLI_PROFILE=your-profile
# TRIAD_WB_CLI_CWD=C:/path/to/your-project
# TRIAD_WB_CLI_MODEL=hy3
# HTTP 网关模式使用下列两项；CLI 模式不需要网关密码。
TRIAD_WB_GATEWAY_URL=http://127.0.0.1:8800
TRIAD_WB_GATEWAY_PASSWORD=

# ---------- Hub 绑定（安全红线：只允许回环）----------
TRIAD_HUB_HOST=127.0.0.1
TRIAD_HUB_PORT=8900

# ---------- 内部鉴权（必填）----------
# HMAC-SHA256 共享密钥，建议 32 字节以上随机串
TRIAD_HUB_HMAC_SECRET=
# 允许的时间戳偏差（秒）
TRIAD_HMAC_SKEW_SEC=60
# 管理端 token（/pause /stop /resume 等管理面）
TRIAD_HUB_ADMIN_TOKEN=

# ---------- 飞书：3 个独立机器人（凭据绝不进代码仓库）----------
FEISHU_WB_APP_ID=
FEISHU_WB_APP_SECRET=
FEISHU_CODEX_APP_ID=
FEISHU_CODEX_APP_SECRET=
FEISHU_HERMES_APP_ID=
FEISHU_HERMES_APP_SECRET=
# 群 ID 白名单（目前仅一个固定群）与操作员身份
FEISHU_CHAT_ID=
# 操作员 union_id（全局唯一、跨应用稳定；open_id 按应用隔离）。
# 配置后只认 union_id 精确匹配（fail-closed）；USER_ID 仅作 union 未配置时的过渡兼容。
# 旧部署可暂用 FEISHU_YANGGE_* 环境变量，新名称优先；迁移后应删除旧变量。
FEISHU_OPERATOR_UNION_ID=
FEISHU_OPERATOR_USER_ID=

# ---------- 飞书 Bot 身份 Open ID ----------
# 不是密码，但属于系统身份配置：必须统一从配置读取，禁止在源码硬编码。
FEISHU_WB_OPEN_ID=
FEISHU_CODEX_OPEN_ID=
FEISHU_HERMES_OPEN_ID=

# ---------- 入口桥 / 可靠出站（非敏感，留注释即用默认值）----------
# TRIAD_HUB_URL=http://127.0.0.1:8900
# TRIAD_BRIDGE_DRY_RUN=true
# TRIAD_OUTBOX_RETRY_DELAYS=5,15,60
# TRIAD_OUTBOX_MAX_ATTEMPTS=3

# ---------- 调用超时 / 租约 / 重试（非敏感，可留空用默认）----------
# TRIAD_CALL_TIMEOUT_SEC=300
# TRIAD_CALL_TIMEOUT_WB_SEC=300
# TRIAD_CALL_TIMEOUT_CODEX_SEC=600
# TRIAD_CALL_TIMEOUT_HERMES_SEC=600
# TRIAD_LEASE_TTL_SEC=900
# TRIAD_CALL_MAX_ATTEMPTS=3
# TRIAD_OUTBOX_MAX_ATTEMPTS=3
# TRIAD_DEDUP_TTL_SEC=120

# ---------- 共享上下文上限（非敏感，可留空用默认）----------
# TRIAD_CONTEXT_MAX_CHARS=12000
# TRIAD_CONTEXT_MAX_DELTA_EVENTS=30
# Optional reviewed cross-run project context; both must be set together.
# TRIAD_PROJECT_MEMORY_ROOT=./shared_project_memory
# TRIAD_PROJECT_MEMORY_ID=your-project-name
# TRIAD_SUMMARY_MAX_CHARS=4000
# TRIAD_VERBATIM_MAX_CHARS=3000
# 注：shared_summaries / context_packets / consumer_cursor_history 由 003_step6_context 迁移建立；
# 摘要拒绝只写稳定错误码（digest_mismatch/evidence_missing/evidence_out_of_range/secret_detected/range_invalid/duplicate_verified_range），不写 Hermes 原文。

# ---------- 外部工具（非敏感）----------
# TRIAD_CODEX_JS=C:/path/to/@openai/codex/bin/codex.js
# TRIAD_CODEX_BIN=C:/path/to/codex.exe
# TRIAD_CODEX_MODEL=your-supported-model
# TRIAD_NODE=C:/path/to/node.exe
# TRIAD_HTTPS_PROXY=http://127.0.0.1:7890

# ---------- 日志 ----------
# TRIAD_LOG_LEVEL=INFO

# ---------- SQLite 路径（默认项目内 triad.db；不覆盖就保持注释）----------
# TRIAD_DB_PATH=
